<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TestProjectType>UnitTest</TestProjectType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Product>QuantConnect.Brokerages.Qmt.Tests</Product>
    <AssemblyName>QuantConnect.Brokerages.Qmt.Tests</AssemblyName>
    <RootNamespace>QuantConnect.Brokerages.Qmt.Tests</RootNamespace>
    <AssemblyTitle>QuantConnect.Brokerages.Qmt.Tests</AssemblyTitle>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantConnect.QmtBrokerage\QuantConnect.QmtBrokerage.csproj" />
  </ItemGroup>
</Project>
